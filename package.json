{
  "name": "capacitor-cmpkit",
  "version": "0.1.0",
  "description": "CMPKit consent management (CMP) for Capacitor apps: cookie banner in the WebView, consent stored natively, and native SDKs started only after the user agrees.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "capacitor",
    "capacitor-plugin",
    "cmpkit",
    "cmp",
    "consent",
    "consent-management-platform",
    "gdpr",
    "ios",
    "android",
    "app-tracking-transparency",
    "privacy"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kendrick-k/capacitor-cmpkit.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "peerDependencies": {
    "@capacitor/core": ">=6.0.0",
    "@capacitor/preferences": ">=6.0.0",
    "@capacitor/app": ">=6.0.0"
  },
  "devDependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "@capacitor/app": "^8.0.0"
  }
}
